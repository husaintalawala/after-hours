# Public build-time flags. Nothing secret belongs in this file — it is committed.
# First-party usage activity: on for every account by default, off per account in
# Settings. A value set in Vercel's project settings overrides this one.
NEXT_PUBLIC_ACTIVITY_ENABLED=true
# Passkey sign-in and enrolment. OFF until passkeys are switched on in the
# Supabase project itself — the dashboard toggle and the relying-party settings
# are both unset today, so every passkey call would fail server-side no matter
# what the browser can do. Turn the project on, set the relying party to the
# production origin, verify a round trip, then flip this. See src/lib/passkeys.ts.
NEXT_PUBLIC_PASSKEYS_ENABLED=false
