# Public build-time flags. Nothing secret belongs in this file — it is committed.
# First-party usage activity: on for every account by default, off per account in
# Settings. A value set in Vercel's project settings overrides this one.
NEXT_PUBLIC_ACTIVITY_ENABLED=true
# Passkey sign-in and enrolment. ON: the Supabase project reports
# passkeys_enabled=true at /auth/v1/settings, with relying party
# drift.after-hours.app and origin https://drift.after-hours.app.
#
# Note those settings are why this cannot be exercised anywhere but production —
# a passkey ceremony requires the page origin to match the relying party, so
# localhost and preview deployments both fail by design, not by misconfiguration.
# See src/lib/passkeys.ts.
NEXT_PUBLIC_PASSKEYS_ENABLED=true
